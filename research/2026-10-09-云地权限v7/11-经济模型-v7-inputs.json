  "cost_notes": {
    "cloud_platform": "MaaS 法律分组分摊（独立上游组织、等保与运维）、境内 CDN（安装包、规则包、法规库增量）、Office/WPS 兼容测试农场、代码签名与时间戳服务",
    "storage": "每席存储与接口许可：密文中继存储与同步流量、服务商应用接口许可等，口径见 editions_note_v6",
    "support": "桌面支持：v6 去掉所内节点与共享文件夹排障（团队 560、律所 450、专业 260 元/席/年），见 editions_note_v6",
    "compute_ocr": "解析、OCR、检索、文书生成在律所硬件上执行，不计入中软成本"
  },
  "cache_note": "基准以“企业协议下前缀缓存可用”为显式前提（ZDR 下缓存是否保留在 P0 谈判中确认）；无缓存见敏感性",
  "fixed_costs_note_v6": "cloud_platform：控制面、中继、网关、公开沙箱的多可用区云资源、对象存储、CDN、HSM/KMS、WAF/堡垒机/日志与数据库审计等等保三级配套（v5 为 15/60/80/100/120 万元）；compliance_certification：在 v5 基础上增加控制面与中继的等保三级测评、商用密码应用安全性评估预留与第三方渗透测试（v5 为 20/70/50/55/60 万元）",
  "editions_note_v6": "support：去掉所内节点与共享文件夹同步的现场排障，云端元数据诊断缩短定位时间（团队 650→560、律所 500→450、专业 280→260 元/席/年）；storage（元/席/年）按以下口径估算：密文中继平均每席 5 GB（含版本与附件）× 对象存储约 0.12 元/GB/月 ≈ 7 元；成员间同步下行约 20 GB/席/年 × 约 0.5 元/GB ≈ 10 元；企业微信等服务商应用接口许可约 4–5 元/账号/年；其余为备份与冗余，合计团队/律所 25 元、专业版 12 元",
  "headcount_note_v6": "G0–G2 工作包约 793 人周（v5 约 690，第 4 篇 §12），按 24 周折算约 +4 人；此后云端后端、SRE 与内容安全常设约 +3 人。相对 v5（29/46/53/59/65）为 +4/+4/+3/+3/+3",
  "headcount_note_v7": "G0–G2 工作包约 869 人周（v6 约 793，第 4 篇 §12），按 24 周折算约 +3 人；此后本机沙箱维护、Kimi Code 上游跟踪与移动 App 常设约 +2 人。相对 v6（33/50/56/62/68）为 +3/+3/+2/+2/+2。",
  "fixed_costs_note_v7": "cloud_platform：取消公开任务沙箱（每任务一容器）、透明日志与见证；新增检索服务与遥控中继（轻量、无状态或只转发密文），合计较 v6 下调约 8%（v6 为 30/170/230/290/350 万元）。",
  "editions_note_v7": "support：Windows 沙箱自检、杀软加白与隔离等级排障使团队/律所/专业版桌面支持各 +40/+30/+20 元/席/年（v6 为 560/450/260）。compute 字段在 v7 表示检索与抓取按次费：合同审查 2 次 search_pro、研究 40 次 search_pro + 20 次 fetch、问答 1 次、Agent 开放任务 15 次 search_pro + 10 次 fetch。open_task：全量工具与子 Agent 使单次 token 约 +20%、各画像月度次数上调（2/4/18，v6 为 1/2/12）。"
}