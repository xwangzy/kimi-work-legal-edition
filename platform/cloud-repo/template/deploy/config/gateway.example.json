{
  "role": "gateway",
  "listen": { "host": "0.0.0.0", "port": 8444 },
  "tls": { "cert_file": "/etc/kwl/tls/gw.crt", "key_file": "/etc/kwl/tls/gw.key" },
  "service_secret_file": "/etc/kwl/secrets/service-secret",
  "control_plane": { "url": "https://cp.kwl.example.com:8443", "keys_file": "/etc/kwl/public/cp-public-keys.json" },
  "seat_keys_file": "/etc/kwl/public/seat-public-keys.json",
  "data_dir": "/var/lib/kwl",
  "upstream": { "base_url": "https://maas.jointpilot.com/v1", "api_key_file": "/etc/kwl/secrets/maas.key" },
  "routing": { "feed": true, "key_file": "/etc/kwl/secrets/routing-key.pem", "allow_hosts": ["maas.jointpilot.com"] },
  "tenant_concurrency": 4,
  "queue_timeout_ms": 30000,
  "upstream_header_timeout_ms": 180000,
  "upstream_idle_timeout_ms": 120000
}
