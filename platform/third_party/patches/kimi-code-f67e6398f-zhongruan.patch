@@ -0,0 +1,241 @@
+import { randomBytes, timingSafeEqual } from 'node:crypto';
+import { join } from 'node:path';
+
+import {
+  bootstrap,
+  drainLogCloses,
+  drainQueryStoreDisposals,
+  drainSessionIndexMirror,
+  drainSessionMetadataWrites,
+  IAppendLogStore,
+  IConfigService,
+  IMcpOAuthService,
+  ISessionIndex,
+  ISessionIndexMirror,
+  IWorkspaceService,
+  logSeed,
+  resolveConfigPath,
+  resolveKimiHome,
+  resolveLoggingConfig,
+  type Scope,
+  type ScopeSeed,
+} from '@moonshot-ai/agent-core-v2';
+import { createKimiDefaultHeaders } from '@moonshot-ai/kimi-code-oauth';
+import Fastify, { type FastifyInstance } from 'fastify';
+
+import { installErrorHandler } from './error-handler';
+import { createAuthHook } from './middleware/auth';
+import { resolveRequestId } from './request-id';
+import { registerApprovalsRoutes } from './routes/approvals';
+import { registerFileHistoryRoutes } from './routes/fileHistory';
+import { registerMessagesRoutes } from './routes/messages';
+import { registerPromptsRoutes } from './routes/prompts';
+import { registerQuestionsRoutes } from './routes/questions';
+import { registerSessionsRoutes } from './routes/sessions';
+import { registerSnapshotRoutes } from './routes/snapshot';
+import { registerTasksRoutes } from './routes/tasks';
+import { registerTranscriptRoutes } from './routes/transcript';
+import type { IAuthTokenService } from './services/auth/authTokenService';
+import { createCredentialValidator } from './services/auth/credentials';
+import {
+  createServerLogger,
+  type ServerLogger,
+  type ServerLogLevel,
+} from './services/pinoLoggerService';
+import { TranscriptService } from './services/transcript/transcriptService';
+import type { ServerHostIdentity } from './start';
+import type { EventEnvelope, JournalIo } from './transport/ws/v1/sessionEventJournal';
+import {
+  SessionEventBroadcaster,
+  type BroadcastTarget,
+} from './transport/ws/v1/sessionEventBroadcaster';
+
+export type EmbeddedMethod = 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE';
+
+export interface EmbeddedServerOptions {
+  readonly homeDir: string;
+  readonly hostIdentity: ServerHostIdentity;
+  readonly env?: NodeJS.ProcessEnv;
+  readonly configPath?: string;
+  readonly skillDirs?: readonly string[];
+  readonly agentFiles?: readonly string[];
+  readonly trustedInstructionsDir?: string;
+  readonly seeds?: ScopeSeed;
+  readonly eventsDir?: string;
+  /** ZP-9a：事件日志 I/O（宿主注入，例如落盘加密；缺省 node fs）。 */
+  readonly eventJournalIo?: JournalIo;
+  readonly logger?: ServerLogger;
+  readonly logLevel?: ServerLogLevel;
+}
+
+export interface EmbeddedResponse {
+  readonly statusCode: number;
+  readonly body: unknown;
+}
+
+export interface EmbeddedServer {
+  readonly core: Scope;
+  readonly listening: false;
+  inject(method: EmbeddedMethod, url: string, payload?: unknown): Promise<EmbeddedResponse>;
+  subscribe(sessionId: string, onEvent: (envelope: EventEnvelope) => void): Promise<() => void>;
+  registeredRoutes(): readonly string[];
+  close(): Promise<void>;
+}
+
+function createMemoryTokenService(): IAuthTokenService {
+  const token = randomBytes(32).toString('base64url');
+  const expected = Buffer.from(token);
+  return {
+    _serviceBrand: undefined,
+    getToken: () => token,
+    isValid: async (candidate) => {
+      const given = Buffer.from(candidate);
+      return given.length === expected.length && timingSafeEqual(given, expected);
+    },
+  };
+}
+
+export async function createEmbeddedServer(opts: EmbeddedServerOptions): Promise<EmbeddedServer> {
+  const homeDir = resolveKimiHome(opts.homeDir);
+  const configPath = resolveConfigPath({ homeDir, configPath: opts.configPath });
+  const logger = opts.logger ?? createServerLogger({ level: opts.logLevel ?? 'warn' });
+  const authTokenService = createMemoryTokenService();
+  const validateCredential = createCredentialValidator(authTokenService);
+  const env = opts.env ?? {};
+  const logging = resolveLoggingConfig({ homeDir, env });
+  const { app: core } = bootstrap(
+    {
+      homeDir,
+      configPath,
+      env,
+      clientIdentity: opts.hostIdentity,
+      args: {
+        requestHeaders: createKimiDefaultHeaders({ homeDir, ...opts.hostIdentity }),
+        skillDirs: opts.skillDirs ?? [],
+        agentFiles: opts.agentFiles,
+        trustedInstructionsDir: opts.trustedInstructionsDir,
+        displayName: opts.hostIdentity.displayName,
+        replyStyleGuide: opts.hostIdentity.replyStyleGuide,
+        uiCapabilities: ['update_panel'],
+      },
+    },
+    [...logSeed(logging), ...(opts.seeds ?? [])],
+  );
+
+  await core.accessor.get(IConfigService).ready;
+  try {
+    await core.accessor.get(IWorkspaceService).list();
+  } catch (error) {
+    logger.warn({ err: error instanceof Error ? error.message : String(error) }, 'workspace catalog sync failed');
+  }
+  try {
+    await core.accessor.get(ISessionIndex).prepare();
+  } catch (error) {
+    logger.warn({ err: error instanceof Error ? error.message : String(error) }, 'session index prepare failed');
+  }
+
+  const app = Fastify({
+    loggerInstance: logger,
+    disableRequestLogging: true,
+    genReqId: (req) => resolveRequestId(req.headers),
+  }) as unknown as FastifyInstance;
+  app.setValidatorCompiler(() => () => true);
+  app.setSerializerCompiler(() => (data) => JSON.stringify(data));
+  installErrorHandler(app);
+  app.addHook('onRequest', createAuthHook(authTokenService, { validateCredential }));
+
+  const routes: string[] = [];
+  app.addHook('onRoute', (route) => {
+    const methods = Array.isArray(route.method) ? route.method : [route.method];
+    for (const method of methods) {
+      if (method !== 'HEAD') routes.push(`${method} ${route.url}`);
+    }
+  });
+
+  const transcriptService = new TranscriptService({ homeDir, core, logger });
+  const broadcaster = new SessionEventBroadcaster({
+    eventsDir: opts.eventsDir ?? join(homeDir, 'server', 'events'),
+    core,
+    logger,
+    transcriptService,
+    ...(opts.eventJournalIo ? { journalIo: opts.eventJournalIo } : {}),
+  });
+
+  await app.register(
+    async (apiV1) => {
+      const host = apiV1 as unknown;
+      registerSessionsRoutes(host as Parameters<typeof registerSessionsRoutes>[0], core, {
+        sessionEventCursor: (sessionId) => broadcaster.getCursor(sessionId),
+      });
+      registerPromptsRoutes(host as Parameters<typeof registerPromptsRoutes>[0], core);
+      registerApprovalsRoutes(host as Parameters<typeof registerApprovalsRoutes>[0], core);
+      registerQuestionsRoutes(host as Parameters<typeof registerQuestionsRoutes>[0], core);
+      registerTasksRoutes(host as Parameters<typeof registerTasksRoutes>[0], core);
+      registerMessagesRoutes(host as Parameters<typeof registerMessagesRoutes>[0], core);
+      registerFileHistoryRoutes(host as Parameters<typeof registerFileHistoryRoutes>[0], core);
+      registerSnapshotRoutes(host as Parameters<typeof registerSnapshotRoutes>[0], { core, broadcaster });
+      registerTranscriptRoutes(host as Parameters<typeof registerTranscriptRoutes>[0], { core, transcriptService });
+    },
+    { prefix: '/api/v1' },
+  );
+  await app.ready();
+
+  const token = authTokenService.getToken();
+
+  const inject = async (method: EmbeddedMethod, url: string, payload?: unknown): Promise<EmbeddedResponse> => {
+    const response = await app.inject({
+      method,
+      url,
+      headers: {
+        authorization: `Bearer ${token}`,
+        ...(payload === undefined ? {} : { 'content-type': 'application/json' }),
+      },
+      payload: payload === undefined ? undefined : JSON.stringify(payload),
+    });
+    let body: unknown = response.body;
+    try {
+      body = JSON.parse(response.body);
+    } catch {
+      body = response.body;
+    }
+    return { statusCode: response.statusCode, body };
+  };
+
+  const subscribe = async (
+    sessionId: string,
+    onEvent: (envelope: EventEnvelope) => void,
+  ): Promise<() => void> => {
+    const target: BroadcastTarget = {
+      send: (envelope) => {
+        onEvent(envelope);
+      },
+    };
+    const ok = await broadcaster.subscribe(sessionId, target);
+    if (!ok) throw new Error(`session ${sessionId} not found`);
+    return () => broadcaster.unsubscribe(sessionId, target);
+  };
+
+  const close = async (): Promise<void> => {
+    await app.close();
+    await broadcaster.close();
+    await drainSessionMetadataWrites();
+    await core.accessor.get(ISessionIndexMirror).drain();
+    await core.accessor.get(IMcpOAuthService).shutdown();
+    const appendLogStore = core.accessor.get(IAppendLogStore);
+    core.dispose();
+    await appendLogStore.drainRetirements();
+    await drainSessionIndexMirror();
+    await drainQueryStoreDisposals();
+    await drainSessionMetadataWrites();
+    await drainLogCloses();
+  };
+
+  return {
+    core,
+    listening: false,
+    inject,
+    subscribe,
+    registeredRoutes: () => [...routes],
+    close,
+  };
+}
