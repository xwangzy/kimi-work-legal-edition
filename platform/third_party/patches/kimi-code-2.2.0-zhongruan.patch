new file mode 100644
index 000000000..2e7756ef9
--- /dev/null
+++ b/packages/agent-core-v2/src/agent/permissionPolicy/hostPolicy.ts
@@ -0,0 +1,90 @@
+import { createDecorator, type ServiceIdentifier } from '#/_base/di/instantiation';
+import { LifecycleScope } from '#/app/scopes';
+import { ScopeActivation, registerScopedService } from '#/_base/di/scope';
+import type { ResolvedToolExecutionHookContext } from '#/agent/toolExecutor/toolHooks';
+import type { ToolInputDisplay } from '#/tool/toolInputDisplay';
+
+import type { PermissionPolicy, PermissionPolicyResult } from './types';
+
+export const HOST_POLICY_NAME = 'host-policy';
+
+export interface HostPolicyRequest {
+  readonly sessionId: string;
+  readonly agentId: string;
+  readonly turnId: number;
+  readonly toolCallId: string;
+  readonly toolName: string;
+  readonly args: unknown;
+  readonly description: string | undefined;
+  readonly display: ToolInputDisplay | undefined;
+}
+
+export interface IHostPolicyProvider {
+  readonly _serviceBrand: undefined;
+  evaluate(request: HostPolicyRequest): PermissionPolicyResult | Promise<PermissionPolicyResult>;
+}
+
+export const IHostPolicyProvider: ServiceIdentifier<IHostPolicyProvider> =
+  createDecorator<IHostPolicyProvider>('hostPolicyProvider');
+
+export class FailClosedHostPolicyProvider implements IHostPolicyProvider {
+  declare readonly _serviceBrand: undefined;
+
+  evaluate(): PermissionPolicyResult {
+    return {
+      kind: 'deny',
+      message: 'Host policy is not configured; every tool call is denied (fail closed).',
+      reason: { host_policy: 'not_configured' },
+    };
+  }
+}
+
+registerScopedService(
+  LifecycleScope.App,
+  IHostPolicyProvider,
+  FailClosedHostPolicyProvider,
+  ScopeActivation.OnDemand,
+  'permissionPolicy',
+);
+
+const DECISION_KINDS = new Set(['approve', 'deny', 'ask']);
+
+export class HostPermissionPolicy implements PermissionPolicy {
+  readonly name = HOST_POLICY_NAME;
+
+  constructor(
+    private readonly provider: IHostPolicyProvider,
+    private readonly identity: { readonly sessionId: string; readonly agentId: string },
+  ) {}
+
+  async evaluate(context: ResolvedToolExecutionHookContext): Promise<PermissionPolicyResult> {
+    const request: HostPolicyRequest = {
+      sessionId: this.identity.sessionId,
+      agentId: this.identity.agentId,
+      turnId: context.turnId,
+      toolCallId: context.toolCall.id,
+      toolName: context.toolCall.name,
+      args: context.args,
+      description: context.execution.description,
+      display: context.execution.display,
+    };
+    let result: PermissionPolicyResult | undefined;
+    try {
+      result = await this.provider.evaluate(request);
+    } catch (error) {
+      return {
+        kind: 'deny',
+        message: 'Host policy failed; the tool call is denied (fail closed).',
+        reason: { host_policy_error: error instanceof Error ? error.message : String(error) },
+      };
+    }
+    if (result === undefined || result === null || !DECISION_KINDS.has(result.kind)) {
+      return {
+        kind: 'deny',
+        message: 'Host policy returned no decision; the tool call is denied (fail closed).',
+        reason: { host_policy: 'no_decision' },
+      };
+    }
+    return result;
+  }
+}
