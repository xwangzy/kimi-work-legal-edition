<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS 应用包的 hardened runtime 权限（electron-builder.yml mac.entitlements / entitlementsInherit；主程序与各 Helper 同一份）。
  只开 Electron 运行必需的三项，不开摄像头、麦克风、Apple 事件、DYLD 环境变量等：
  - allow-jit、allow-unsigned-executable-memory：V8 JIT；
  - disable-library-validation：ad-hoc 签名没有团队标识，库校验会拒绝装载 Electron 框架与 asar.unpacked 里的原生模块
    （better-sqlite3-multiple-ciphers 保留原签名、不重签，见 mac.signIgnore）。接入 Developer ID 签名后可评估去掉。
  随包运行时（Resources/runtime 下的官方 Node）是独立程序，用 OpenJS 基金会签名里自带的权限，不受本文件影响。
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
