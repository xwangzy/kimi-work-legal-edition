<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS 应用包的 hardened runtime 权限（electron-builder.yml mac.entitlements / entitlementsInherit；主程序与各 Helper 同一份）。
  只开 Electron 运行必需的两项，不开摄像头、麦克风、Apple 事件、DYLD 环境变量等：
  - allow-jit：V8 JIT（MAP_JIT）。第 60 批去掉 allow-unsigned-executable-memory（Electron 官方签名工具 @electron/osx-sign 的缺省权限
    只有 allow-jit；以本安装包实测冒烟与端到端任务验证，见研究记录 V34）；
  - disable-library-validation：ad-hoc 签名没有团队标识，库校验会拒绝装载 Electron 框架与 asar.unpacked 里的原生模块
    （better-sqlite3-multiple-ciphers 保留原签名、不重签，见 mac.signIgnore）。接入 Developer ID 签名后可评估去掉。
  随包运行时（Resources/runtime 下的官方 Node）是独立程序，用 OpenJS 基金会签名里自带的权限，不受本文件影响。
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
