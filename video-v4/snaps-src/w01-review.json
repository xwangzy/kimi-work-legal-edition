{"theme":"light","htmlClass":"frameless plat-darwin","bodyClass":"","html":"\n    <div id=\"root\"><div class=\"shell\"><div class=\"window-drag\" aria-hidden=\"true\"></div><aside class=\"sidebar compact\" data-tour=\"sidebar\"><div class=\"brand\"><button class=\"brand-mark-btn\" title=\"展开侧栏\" aria-label=\"展开侧栏\" aria-expanded=\"false\"><svg class=\"logo-mark brand-logo\" viewBox=\"0 0 180 180\" aria-hidden=\"true\" focusable=\"false\"><rect class=\"logo-mark-bg\" width=\"180\" height=\"180\" rx=\"45\"></rect><path class=\"logo-mark-dot\" d=\"M139.13 36.5137C144.237 36.5137 148.377 40.6535 148.377 45.7602C148.377 50.867 144.237 55.0068 139.13 55.0068L130.972 55.0068C130.371 55.0068 129.884 54.5198 129.884 53.919L129.884 45.7602C129.884 40.6535 134.024 36.5137 139.13 36.5137Z\"></path><path class=\"logo-mark-k\" d=\"M87.2905 90.3594L122.186 55.739C122.842 55.0865 122.473 53.7744 121.625 53.7744H102.848C102.644 53.7744 102.447 53.8577 102.288 54.0174L64.6898 91.3104C64.1035 91.8866 63.2366 91.3729 63.2366 90.4496V54.8782C63.2366 54.2673 62.8351 53.7744 62.3443 53.7744H49.406C48.9152 53.7744 48.5137 54.2673 48.5137 54.8782V131.575C48.5137 132.186 48.9152 132.679 49.406 132.679H62.3443C62.8351 132.679 63.2366 132.186 63.2366 131.575V115.948C63.2366 115.615 63.3577 115.295 63.5681 115.087L75.2254 103.522C75.5058 103.244 75.8946 103.202 76.2069 103.411L107.386 126.354C112.492 129.791 118.196 131.901 123.99 132.526C124.506 132.581 124.952 132.068 124.952 131.422V116.705C124.952 116.142 124.614 115.684 124.162 115.615C120.752 115.08 117.425 113.761 114.417 111.734L87.4244 92.1921C86.8635 91.8172 86.7934 90.8523 87.2905 90.3594Z\"></path></svg><span class=\"brand-expand-ico\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3.5\" y=\"4.5\" width=\"17\" height=\"15\" rx=\"2.5\"></rect><path d=\"M9.5 4.5v15\">