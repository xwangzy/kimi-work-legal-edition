{
  "name": "kimi-work-legal-film-v4",
  "version": "1.0.0",
  "private": true,
  "description": "Kimi Work 法律行业发行版 · 产品宣传片 V4（Remotion 工程）",
  "scripts": {
    "music": "node scripts/make-music.mjs && SCORE=cut30 node scripts/make-music.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts KimiWorkLegalV4 out/kimi-work-legal-film-v4-4k60.mp4 --scale=2 --codec=h264 --crf=14 --pixel-format=yuv420p",
    "still": "remotion still src/index.ts KimiWorkLegalV4 out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@remotion/cli": "4.0.531",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.531"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.9.3"
  },
  "type": "module"
}
